# CloudDrop — Client Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER add AWS credentials here — the frontend must NEVER touch AWS directly.

# Base URL for the API.
# In development: leave empty — Vite proxies /api to localhost:5000 automatically.
# In production: leave empty — Nginx forwards /api to the backend on the same host.
# Only set this if your API lives on a completely different domain.
VITE_API_BASE_URL=
